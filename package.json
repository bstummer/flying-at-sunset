{
  "name": "flying-at-sunset",
  "private": true,
  "version": "0.0.0",
  "description": "A paper bird gliding over an endless sea of clouds at golden hour, in one self-contained HTML file.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "postinstall": "playwright install --only-shell chromium",
    "dev": "vite",
    "test": "node --test --test-concurrency=4",
    "build": "vite build",
    "check": "node tools/check-build.js",
    "shot": "npm run build && node tools/screenshot.js",
    "map": "node tools/world/map.js",
    "verify": "npm test && npm run build && npm run check && node tools/screenshot.js --checks",
    "verify:ci": "npm run verify -- --gl swiftshader --size 320x180 --frames 8 --no-measurements"
  },
  "devDependencies": {
    "playwright": "^1.64.1",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
